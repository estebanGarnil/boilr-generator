{% for dep in dependencies.base %}
{{ dep }}
{% endfor %}
{% set database = bindings.primary_database %}

{% if options.rest_framework %}
{% for dep in dependencies.rest_framework %}
{{ dep }}
{% endfor %}
{% endif %}

{% if options.cors %}
{% for dep in dependencies.cors %}
{{ dep }}
{% endfor %}
{% endif %}

{% if database.engine in ["postgres", "postgresql"] %}
{% for dep in dependencies.postgres %}
{{ dep }}
{% endfor %}
{% endif %}

{% if database.engine == "mysql" %}
{% for dep in dependencies.mysql %}
{{ dep }}
{% endfor %}
{% endif %}